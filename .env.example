# Copy this file to .env.local for local development.
# On Vercel, add the same names under Project > Settings > Environment Variables.
# Never commit .env.local: it holds passwords.

# Supabase > Project Settings > API (or "Connect"): Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase > Project Settings > API Keys: the Publishable key (sb_publishable_...)
# Older projects call this the "anon public" key; that works too.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Supabase > Project Settings > API Keys: the Secret key (sb_secret_...)
# Older projects call this the "service_role" key; that works too.
# SERVER ONLY. Never put NEXT_PUBLIC_ in front of this name.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# The website's address, used in password links and ready-made messages.
# Local: http://localhost:3000   On Vercel: https://your-site.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
